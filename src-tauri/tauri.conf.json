{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slipstream",
  "version": "0.2.0",
  "identifier": "dev.local.slipstream",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Slipstream",
        "width": 1100,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 760,
        "maxWidth": 1100,
        "maxHeight": 760,
        "resizable": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
